{
  "name": "core-pvs-proto",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:event-demo": "pnpm --filter event-demo dev",
    "dev:main-app": "pnpm --filter main-app dev",
    "build": "pnpm --filter @pvs/db build && pnpm --filter @pvs/shared build && pnpm --filter event-demo build && pnpm --filter main-app build",
    "build:packages": "pnpm --filter @pvs/db build && pnpm --filter @pvs/shared build",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @pvs/db migrate",
    "db:seed": "pnpm --filter @pvs/db seed",
    "db:search-index": "pnpm --filter @pvs/db search:extract",
    "db:reset": "pnpm --filter @pvs/db reset"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
