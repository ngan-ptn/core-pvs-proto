    "system_behavior": "string",
    "severity": "high | medium | low"
  },
  "examples": [
    {
      "obligation_id": "OBL-PR-001",
      "domain": "Prescription",
      "trigger_point": "on_review",
      "ux_surface": "warning_banner",
      "system_behavior": "drug_interaction_check",
      "severity": "high"
    },
    {
      "obligation_id": "OBL-PR-045",
      "domain": "Prescription",
      "trigger_point": "on_sign",
      "ux_surface": "confirmation_modal",
      "system_behavior": "qes_required",
      "severity": "high"
    }
  ]
